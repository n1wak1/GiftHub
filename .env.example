TON_NETWORK=testnet
ESCROW_ADDRESS=UQB32u8KyV9ddFO0Mi34DMCSGiupNot2yfM4Nu8YIVERfrY9
# Required for automatic TON/USDT withdrawals from the escrow wallet.
# This seed must derive ESCROW_ADDRESS. Keep it secret and store it only in Render env.
# ESCROW_WALLET_MNEMONIC=word1 word2 ... word24
# Optional if your wallet is not auto-detected from ESCROW_ADDRESS: v4, v5r1, or v3r2.
# ESCROW_WALLET_VERSION=v4
# Extra TON kept on the escrow wallet so exact TON withdrawals can pay network gas.
# TON_WITHDRAW_GAS_RESERVE_NANOTON=50000000
# Same bot as the Mini App — for avatars (GET /profiles/:tgId/avatar) and names of counterparties (GET /profiles/:tgId/telegram).
# TELEGRAM_BOT_TOKEN=123456:ABC...
# Telegram account/contact that stores gifts. Connect this account to the bot via Telegram Business.
# TELEGRAM_BUSINESS_CONNECTION_ID=...
# TELEGRAM_VAULT_CONTACT_USERNAME=GiftHubVault
# Keep false/empty while Telegram blocks "Transfer and Upgrade Gifts"; manual admin confirmation will be used.
# TELEGRAM_BUSINESS_GIFT_TRANSFER_ENABLED=false
# Required for manual admin endpoints that confirm gift transfers/withdrawals after you transfer from the vault contact.
# ADMIN_SECRET=change-me-long-random-string
# Where to save deals-store.json (default: ./data/deals-store.json). On Render with a persistent disk, set mount path here.
# DATA_DIR=/var/data
# Use a single Render instance OR Redis — otherwise seller and buyer may hit different servers and see different deals.
# Free tier: https://upstash.com — create Redis, paste REST URL + token:
# UPSTASH_REDIS_REST_URL=https://xxxx.upstash.io
# UPSTASH_REDIS_REST_TOKEN=AXxx...
# Comma-separated allowed origins for Mini App (Vercel). If unset, all origins are allowed.
# CORS_ORIGIN=https://your-app.vercel.app
# Optional:
# USDT_JETTON_MASTER=
# TONAPI_KEY=
# MIN_FEE_USDT=0.2
# FEE_THRESHOLD_USDT=15
# FEE_BPS_USDT=500
# MIN_FEE_TON=0.02
# FEE_THRESHOLD_TON=15
# FEE_BPS_TON=500

